# ignore html files
*.html
main.pdf
./feedback/*.pdf
*.lof
*.aux
*.log
*.lot
*.out
*.bbl
*.blg
*.toc

# ignore all textual files
*.txt

# ignore object and archive files
*.[oa]

# ignore auto-saved files
*~
\#*\#

# excepted these manually configured files
!CMakeLists.txt
!tests/golden/*.txt
!bench/instances/*.txt
!README.txt
!application/
!doc/
!lib/
!src/
!test/

# ignore built files
*/build/
*/release/*
*/debug/*
*/build/*



# build trees and local presets
/build/
CMakeUserPresets.json

# Python bytecode
__pycache__/

# The website (bash site/build.sh): Quarto's cache and the fetched fonts stay local. The rendered
# site in docs/ is committed for GitHub Pages, so the *.html and *.txt rules above must not apply.
/site/.quarto/
/site/fonts/*.ttf
!/docs/**
!/site/graph/**
